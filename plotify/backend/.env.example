# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-in-production

# SQLite (relative to backend/ directory)
DATABASE_URI=sqlite:///plotify.db

# Hardhat local node (run: cd blockchain && npx hardhat node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Set after deploying the contract:
# cd blockchain && npx hardhat run scripts/deploy.js --network localhost
CONTRACT_ADDRESS=

# First Hardhat test account private key — DO NOT use on mainnet or any live network
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# JWT
JWT_EXPIRY_HOURS=24
